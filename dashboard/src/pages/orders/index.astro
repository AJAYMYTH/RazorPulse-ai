---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { fetchOrders } from '../../lib/api';

const orders = await fetchOrders();
const acceptedCount = orders.filter((o: any) => o.gate_result === 'accepted').length;
const rejectedCount = orders.filter((o: any) => o.gate_result === 'rejected').length;
---

<Layout title="Order Decision Trails" activeNav="orders">
  <!-- Top Breadcrumb & Title -->
  <div class="mb-6">
    <nav class="flex items-center space-x-2 text-xs font-mono text-mute mb-3">
      <a href="/" class="hover:text-ink transition">Dashboard</a>
      <span>/</span>
      <span class="text-ink font-medium">Order Trails</span>
    </nav>

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4 border-b border-hairline">
      <div>
        <h1 class="text-2xl sm:text-3xl font-semibold text-ink tracking-tight">Order Decision Trails</h1>
        <p class="text-body text-xs sm:text-sm mt-1 max-w-2xl">
          Immutable 5-stage chronological audit records for every order processed by RazorPulse AI. No horizontal scrolling required.
        </p>
      </div>

      <div class="flex items-center space-x-2 text-xs font-mono text-mute">
        <span>Total Orders: <strong class="text-ink">{orders.length}</strong></span>
        <span>·</span>
        <span class="text-emerald-600 font-semibold">{acceptedCount} Approved</span>
        <span>·</span>
        <span class="text-amber-600 font-semibold">{rejectedCount} Blocked</span>
      </div>
    </div>
  </div>

  <!-- Unified Controls Bar: Search & Category Filter Pills -->
  <div class="mb-6 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
    <!-- Search Input (h-10 with generous padding) -->
    <div class="relative flex-1 max-w-md">
      <input
        type="text"
        id="order-search"
        placeholder="Search by Order ID, Customer, or SKU..."
        oninput="handleSearch()"
        class="w-full h-10 pl-10 pr-4 rounded-[8px] bg-canvas-elevated border border-hairline text-xs text-ink placeholder:text-mute focus:outline-none focus:border-ink transition shadow-whisper"
      />
      <svg class="w-4 h-4 text-mute absolute left-3.5 top-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>

    <!-- Category Filter Pills (h-10 with generous margins & padding) -->
    <div class="flex items-center space-x-1.5 p-1 bg-canvas-elevated rounded-pill border border-hairline shadow-whisper self-start sm:self-auto">
      <button
        onclick="setFilter('all')"
        id="btn-all"
        class="filter-btn h-8 px-4 text-xs font-medium rounded-pill bg-ink text-white transition shadow-whisper cursor-pointer"
      >
        All ({orders.length})
      </button>
      <button
        onclick="setFilter('accepted')"
        id="btn-accepted"
        class="filter-btn h-8 px-4 text-xs font-medium rounded-pill text-body hover:text-ink transition cursor-pointer"
      >
        Approved ({acceptedCount})
      </button>
      <button
        onclick="setFilter('rejected')"
        id="btn-rejected"
        class="filter-btn h-8 px-4 text-xs font-medium rounded-pill text-body hover:text-ink transition cursor-pointer"
      >
        Gate Blocked ({rejectedCount})
      </button>
    </div>
  </div>

  <!-- Orders List: 100% Fit, Zero Horizontal Scroll Needed -->
  <div class="space-y-3" id="orders-container">
    
    <!-- Table Header for Large Displays (Hidden on mobile/tablet) -->
    <div class="hidden lg:grid grid-cols-12 gap-4 px-5 py-2.5 bg-canvas font-mono uppercase text-mute text-[11px] tracking-wider rounded-[6px] border border-hairline">
      <div class="col-span-3">Order & Customer</div>
      <div class="col-span-2">Cart Amount</div>
      <div class="col-span-3">AI Recommendation</div>
      <div class="col-span-2">Gate Status</div>
      <div class="col-span-2 text-right">Actions</div>
    </div>

    <!-- Order Items (Responsive: Full-width grid on desktop, clean card on mobile) -->
    {orders.map((o: any) => (
      <div
        class="order-item bg-canvas-elevated border border-hairline hover:border-[#d4d4d4] rounded-md p-4 sm:p-5 transition shadow-whisper"
        data-gate={o.gate_result}
        data-search={`${o.id} ${o.customer_name} ${o.recommended_sku || ''} ${o.gate_reason || ''}`.toLowerCase()}
      >
        <!-- Desktop Grid View (>= 1024px) -->
        <div class="hidden lg:grid grid-cols-12 gap-4 items-center">
          
          <!-- Col 1: Order ID & Customer Profile (3 cols) -->
          <div class="col-span-3 space-y-1">
            <div class="flex items-center space-x-2">
              <a
                href={`/orders/${o.id}`}
                class="font-mono text-xs font-semibold text-ink hover:underline truncate block"
                title={o.id}
              >
                {o.id}
              </a>
            </div>
            <div class="flex items-center space-x-2 text-xs">
              <span class="text-ink font-medium">{o.customer_name}</span>
              <span class="text-hairline">·</span>
              <span class="text-[11px] text-mute font-mono">
                {o.customer_order_count > 2 ? (
                  <span class="inline-flex items-center space-x-0.5 text-amber-600 font-medium">
                    <Icon name="star" class="w-2.5 h-2.5 fill-amber-500 stroke-amber-500" />
                    <span>Repeat</span>
                  </span>
                ) : (
                  <span>New</span>
                )}
              </span>
            </div>
          </div>

          <!-- Col 2: Cart Amount & Items (2 cols) -->
          <div class="col-span-2">
            <div class="font-mono text-sm font-semibold text-ink">
              ₹{o.total_amount.toLocaleString()}
            </div>
            <div class="text-[11px] font-mono text-mute mt-0.5">
              Status: <span class="text-ink capitalize">{o.status}</span>
            </div>
          </div>

          <!-- Col 3: AI Offer Suggestion (3 cols) -->
          <div class="col-span-3 space-y-1">
            {o.action === 'cross_sell' && (
              <div>
                <div class="flex items-center space-x-1.5">
                  <span class="font-mono text-[10px] uppercase font-bold px-1.5 py-0.5 rounded-[4px] bg-blue-50 text-[#0066FF] border border-blue-200">
                    Cross-Sell
                  </span>
                  <span class="font-mono text-xs font-semibold text-ink">
                    {o.discount_pct}% OFF
                  </span>
                </div>
                <div class="font-mono text-[11px] text-body mt-1 truncate" title={o.recommended_sku}>
                  {o.recommended_sku}
                </div>
              </div>
            )}
            {o.action === 'upsell' && (
              <div>
                <div class="flex items-center space-x-1.5">
                  <span class="font-mono text-[10px] uppercase font-bold px-1.5 py-0.5 rounded-[4px] bg-purple-50 text-purple-700 border border-purple-200">
                    Upsell
                  </span>
                  <span class="font-mono text-xs font-semibold text-ink">
                    {o.discount_pct}% OFF
                  </span>
                </div>
                <div class="font-mono text-[11px] text-body mt-1 truncate" title={o.recommended_sku}>
                  {o.recommended_sku}
                </div>
              </div>
            )}
            {o.action === 'none' && (
              <div>
                <span class="font-mono text-[10px] uppercase font-medium px-2 py-0.5 rounded-[4px] bg-canvas text-mute border border-hairline">
                  No Offer (Action None)
                </span>
                <div class="text-[11px] text-mute mt-1">Low-confidence threshold</div>
              </div>
            )}
          </div>

          <!-- Col 4: Gate Shield Outcome (2 cols) -->
          <div class="col-span-2">
            {o.gate_result === 'accepted' ? (
              <div>
                <span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-[#f0fdf4] text-[#15803d] border border-[#bbf7d0]">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#16a34a]"></span>
                  <span>Approved</span>
                </span>
                <div class="text-[11px] font-mono text-mute mt-1">Passed all bounds</div>
              </div>
            ) : (
              <div>
                <span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-[#fffbeb] text-[#b45309] border border-[#fde68a]">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
                  <span>Gate Blocked</span>
                </span>
                <div class="text-[11px] text-mute font-mono mt-1 truncate" title={o.gate_reason}>
                  {o.gate_reason}
                </div>
              </div>
            )}
          </div>

          <!-- Col 5: Payment Link & Action Button (2 cols) -->
          <div class="col-span-2 flex flex-col items-end space-y-2">
            {o.payment_link_url ? (
              o.payment_link_url.includes('plink_test') ? (
                <a
                  href={`/orders/${o.id}?preview=checkout`}
                  class="font-mono text-[11px] text-[#0066FF] hover:underline font-semibold inline-flex items-center space-x-1"
                  title="Open interactive sandbox checkout simulation"
                >
                  <span>Sandbox Link ↗</span>
                </a>
              ) : (
                <a
                  href={o.payment_link_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-[11px] text-emerald-600 hover:underline font-semibold inline-flex items-center space-x-1"
                  title="Open live payment link on Razorpay"
                >
                  <span>Pay on Razorpay ↗</span>
                </a>
              )
            ) : o.gate_result === 'rejected' ? (
              <span class="text-[11px] font-mono text-mute">Halted at Gate</span>
            ) : null}

            <a
              href={`/orders/${o.id}`}
              class="h-8 px-3.5 rounded-[6px] bg-ink text-white hover:bg-[#2e2e2e] transition shadow-whisper text-xs font-medium inline-flex items-center space-x-1.5"
            >
              <span>Audit Trail</span>
              <span>&rarr;</span>
            </a>
          </div>

        </div>

        <!-- Mobile / Tablet Card View (< 1024px) -->
        <div class="lg:hidden space-y-3.5">
          
          <!-- Top Row: Order ID, Amount, Gate Status Badge -->
          <div class="flex items-start justify-between gap-2 pb-2.5 border-b border-hairline">
            <div>
              <a href={`/orders/${o.id}`} class="font-mono text-xs font-bold text-ink hover:underline">
                {o.id}
              </a>
              <div class="text-xs text-body mt-0.5 flex items-center space-x-1">
                <span>{o.customer_name}</span>
                <span class="text-mute font-mono text-[11px]">(
                  {o.customer_order_count > 2 ? (
                    <span class="inline-flex items-center space-x-0.5 text-amber-600 font-medium">
                      <Icon name="star" class="w-2.5 h-2.5 fill-amber-500 stroke-amber-500" />
                      <span>Repeat</span>
                    </span>
                  ) : (
                    'New'
                  )}
                )</span>
              </div>
            </div>
            <div class="text-right">
              <div class="font-mono text-sm font-semibold text-ink">₹{o.total_amount.toLocaleString()}</div>
              {o.gate_result === 'accepted' ? (
                <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-[#f0fdf4] text-[#15803d] border border-[#bbf7d0] mt-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#16a34a]"></span>
                  <span>Approved</span>
                </span>
              ) : (
                <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-[#fffbeb] text-[#b45309] border border-[#fde68a] mt-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
                  <span>Blocked</span>
                </span>
              )}
            </div>
          </div>

          <!-- Middle Row: Recommendation & Gate Reason -->
          <div class="text-xs space-y-1.5">
            <div class="flex items-center space-x-2">
              <span class="text-mute font-mono text-[11px]">Offer:</span>
              {o.action !== 'none' ? (
                <span class="font-mono text-xs font-medium text-ink">
                  {o.action} · {o.recommended_sku} ({o.discount_pct}% OFF)
                </span>
              ) : (
                <span class="text-mute font-mono text-xs">None (Action none)</span>
              )}
            </div>

            {o.gate_result === 'rejected' && (
              <div class="p-2 rounded bg-canvas border border-hairline text-[11px] font-mono text-amber-800">
                Reason: {o.gate_reason}
              </div>
            )}
          </div>

          <!-- Bottom Row: Payment Link & Action CTA -->
          <div class="pt-2 flex items-center justify-between gap-2 border-t border-hairline">
            <div>
              {o.payment_link_url ? (
                o.payment_link_url.includes('plink_test') ? (
                  <a
                    href={`/orders/${o.id}?preview=checkout`}
                    class="font-mono text-xs text-[#0066FF] hover:underline font-semibold inline-flex items-center space-x-1"
                    title="Open interactive checkout preview"
                  >
                    <span>Sandbox Link ↗</span>
                  </a>
                ) : (
                  <a
                    href={o.payment_link_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-xs text-emerald-600 hover:underline font-semibold inline-flex items-center space-x-1"
                    title="Open live payment link on Razorpay"
                  >
                    <span>Pay on Razorpay ↗</span>
                  </a>
                )
              ) : (
                <span class="text-xs font-mono text-mute">Protected by Gate</span>
              )}
            </div>

            <a
              href={`/orders/${o.id}`}
              class="h-8 px-4 rounded-[6px] bg-ink text-white hover:bg-[#2e2e2e] transition text-xs font-medium inline-flex items-center space-x-1.5 shadow-whisper"
            >
              <span>View Audit Trail</span>
              <span>&rarr;</span>
            </a>
          </div>

        </div>

      </div>
    ))}

    <!-- Empty State -->
    <div id="no-results" class="hidden bg-canvas-elevated border border-hairline rounded-md p-10 text-center space-y-2">
      <div class="text-ink font-semibold text-sm">No matching orders found</div>
      <p class="text-mute text-xs">Try searching for a different Order ID, customer name, or SKU.</p>
      <button
        onclick="clearSearch()"
        class="mt-3 h-8 px-4 rounded-[6px] bg-canvas border border-hairline text-ink text-xs font-medium hover:bg-hairline-soft transition inline-flex items-center"
      >
        Clear Filters
      </button>
    </div>

  </div>

  <!-- Interactive Filter & Search Client-Side Engine -->
  <script is:inline>
    let currentFilter = 'all';

    function setFilter(filter) {
      currentFilter = filter;
      const buttons = document.querySelectorAll('.filter-btn');

      buttons.forEach((btn) => {
        btn.classList.remove('bg-ink', 'text-white');
        btn.classList.add('text-body');
      });

      const activeBtn = document.getElementById(`btn-${filter}`);
      if (activeBtn) {
        activeBtn.classList.add('bg-ink', 'text-white');
        activeBtn.classList.remove('text-body');
      }

      applyFilters();
    }

    function handleSearch() {
      applyFilters();
    }

    function clearSearch() {
      const searchInput = document.getElementById('order-search');
      if (searchInput) searchInput.value = '';
      setFilter('all');
    }

    function applyFilters() {
      const searchVal = document.getElementById('order-search')?.value.toLowerCase().trim() || '';
      const items = document.querySelectorAll('.order-item');
      let visibleCount = 0;
      const newlyVisible = [];

      items.forEach((item) => {
        const gate = item.getAttribute('data-gate');
        const searchTarget = item.getAttribute('data-search') || '';

        const matchesGate = (currentFilter === 'all' || gate === currentFilter);
        const matchesSearch = !searchVal || searchTarget.includes(searchVal);

        if (matchesGate && matchesSearch) {
          if (item.style.display === 'none') {
            newlyVisible.push(item);
          }
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      const noResults = document.getElementById('no-results');
      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      // Smooth Anime.js transition on newly visible items
      if (typeof anime !== 'undefined' && newlyVisible.length > 0) {
        anime({
          targets: newlyVisible,
          opacity: [0, 1],
          translateY: [8, 0],
          duration: 320,
          delay: anime.stagger(25),
          easing: 'cubicBezier(0.16, 1, 0.3, 1)'
        });
      }
    }
  </script>
</Layout>
