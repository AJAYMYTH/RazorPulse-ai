---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { fetchOrders, fetchOrderTrail } from '../../lib/api';

export async function getStaticPaths() {
  const orders = await fetchOrders();
  return orders.map((o: any) => ({
    params: { id: o.id },
  }));
}

const { id } = Astro.params;
const { order, customer, trail } = await fetchOrderTrail(id as string);

if (!order) {
  return Astro.redirect('/orders');
}

// Stage lookups
const triggerStage = trail.find((d: any) => d.stage === 'trigger');
const signalStage = trail.find((d: any) => d.stage === 'signal');
const decisionStage = trail.find((d: any) => d.stage === 'decision');
const gateStage = trail.find((d: any) => d.stage === 'gate');
const executionStage = trail.find((d: any) => d.stage === 'execution');

const isAccepted = gateStage?.result === 'accepted';
const isRejected = gateStage?.result === 'rejected';

// Deterministic rule evaluation values for checklist
const discountVal = decisionStage?.payload?.discount_pct ?? 0;
const confVal = decisionStage?.payload?.confidence ?? 0;
const rule1Pass = discountVal <= 15;
const rule3Pass = order.status !== 'refunded' && order.status !== 'disputed';
const rule4Pass = confVal >= 0.60;
---

<Layout title={`Order Trail · ${id}`} activeNav="orders">
  <!-- Breadcrumbs & Header Bar -->
  <div class="mb-6 space-y-3">
    <div class="flex items-center justify-between">
      <nav class="flex items-center space-x-2 text-xs font-mono text-mute">
        <a href="/" class="hover:text-ink transition">Dashboard</a>
        <span>/</span>
        <a href="/orders" class="hover:text-ink transition">Order Trails</a>
        <span>/</span>
        <span class="text-ink font-semibold">{order.id}</span>
      </nav>

      <a
        href="/orders"
        class="h-8 px-3.5 rounded-[6px] bg-canvas-elevated border border-hairline text-body hover:text-ink text-xs font-medium inline-flex items-center space-x-1.5 shadow-whisper transition cursor-pointer"
      >
        <span>&larr;</span>
        <span>Back to Order Trails</span>
      </a>
    </div>

    <!-- Main Order Info Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-5 border-b border-hairline">
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-2xl sm:text-3xl font-semibold text-ink font-mono tracking-tight">{order.id}</h1>
          {isAccepted && (
            <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-medium bg-[#f0fdf4] text-[#15803d] border border-[#bbf7d0]">
              <span class="w-1.5 h-1.5 rounded-full bg-[#16a34a]"></span>
              <span>Gate Shield Approved</span>
            </span>
          )}
          {isRejected && (
            <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-medium bg-[#fffbeb] text-[#b45309] border border-[#fde68a]">
              <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
              <span>Deterministic Gate Blocked</span>
            </span>
          )}
        </div>
        <p class="text-body text-xs sm:text-sm mt-1.5">
          Customer: <strong class="text-ink">{customer?.name || 'Guest'}</strong> ({customer?.order_count > 2 ? (
            <span class="inline-flex items-center space-x-1 text-amber-600 font-medium">
              <Icon name="star" class="w-3 h-3 fill-amber-500 stroke-amber-500" />
              <span>Repeat Buyer</span>
            </span>
          ) : (
            'New Customer'
          )}) · Cart Total: <strong class="text-ink font-mono">₹{order.total_amount.toLocaleString()}</strong>
        </p>
      </div>

      <div class="flex items-center space-x-2">
        <span class="font-mono text-xs text-mute uppercase tracking-wider px-3 py-1.5 rounded-[6px] bg-canvas-elevated border border-hairline shadow-whisper">
          Status: <strong class="text-ink font-bold">{order.status}</strong>
        </span>
      </div>
    </div>
  </div>

  <!-- Customer Basket Items Grid -->
  <div class="bg-canvas-elevated border border-hairline rounded-md p-5 mb-8 shadow-whisper">
    <div class="font-mono text-[11px] uppercase text-mute tracking-wider mb-3">Customer Purchased Items</div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {order.items.map((item: any) => (
        <div class="bg-canvas border border-hairline p-3.5 rounded-[6px] flex items-center justify-between">
          <div class="truncate mr-2">
            <div class="font-mono text-xs font-semibold text-ink truncate">{item.sku}</div>
            <div class="text-xs text-body mt-0.5 truncate">{item.name || item.sku}</div>
          </div>
          <div class="text-right flex-shrink-0">
            <div class="font-mono text-xs font-semibold text-ink">₹{item.price.toLocaleString()}</div>
            <div class="text-[11px] text-mute font-mono">Qty: {item.quantity}</div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- 5-Stage Vertical Timeline: Pure Flex Track Architecture (Zero Negative Margins, 100% Centered on Line) -->
  <div class="space-y-0">

    <!-- STAGE 1: TRIGGER -->
    <div class="flex items-stretch gap-4 sm:gap-6 anime-stage-step">
      <!-- Dedicated Timeline Track Column -->
      <div class="flex flex-col items-center flex-shrink-0 w-8">
        <div class="w-8 h-8 rounded-full bg-ink text-white font-mono text-xs font-bold flex items-center justify-center shadow-whisper z-10 flex-shrink-0">
          1
        </div>
        <!-- Continuous vertical connecting line directly centered through node -->
        <div class="w-[2px] bg-hairline flex-1 my-1"></div>
      </div>

      <!-- Stage 1 Content Card -->
      <div class="flex-1 pb-8">
        <div class="bg-canvas-elevated border border-hairline rounded-md p-5 sm:p-6 shadow-whisper">
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-hairline">
            <div class="flex items-center space-x-2.5">
              <span class="font-mono text-[11px] uppercase text-mute tracking-wider font-semibold">Stage 01 · Ingestion</span>
              <span class="text-sm font-semibold text-ink">Order Trigger & Filter</span>
            </div>
            <span class="font-mono text-xs font-medium px-2 py-0.5 rounded-[4px] bg-[#f0fdf4] text-[#15803d] border border-[#bbf7d0]">
              PASSED
            </span>
          </div>
          <p class="text-xs text-body mb-3 font-mono leading-relaxed">{triggerStage?.reason || 'Order passed basket value and item checks'}</p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 font-mono text-xs text-body">
            <div class="bg-canvas p-2.5 rounded-[6px] border border-hairline">
              <span class="text-mute text-[10px] uppercase block">Status</span>
              <span class="text-ink font-semibold">{order.status}</span>
            </div>
            <div class="bg-canvas p-2.5 rounded-[6px] border border-hairline">
              <span class="text-mute text-[10px] uppercase block">Cart Value</span>
              <span class="text-ink font-semibold">₹{order.total_amount}</span>
            </div>
            <div class="bg-canvas p-2.5 rounded-[6px] border border-hairline">
              <span class="text-mute text-[10px] uppercase block">Item Count</span>
              <span class="text-ink font-semibold">{order.items.length} line item(s)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- STAGE 2: SIGNAL -->
    <div class="flex items-stretch gap-4 sm:gap-6 anime-stage-step">
      <div class="flex flex-col items-center flex-shrink-0 w-8">
        <div class="w-8 h-8 rounded-full bg-ink text-white font-mono text-xs font-bold flex items-center justify-center shadow-whisper z-10 flex-shrink-0">
          2
        </div>
        <div class="w-[2px] bg-hairline flex-1 my-1"></div>
      </div>

      <!-- Stage 2 Content Card -->
      <div class="flex-1 pb-8">
        <div class="bg-canvas-elevated border border-hairline rounded-md p-5 sm:p-6 shadow-whisper">
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-hairline">
            <div class="flex items-center space-x-2.5">
              <span class="font-mono text-[11px] uppercase text-mute tracking-wider font-semibold">Stage 02 · Signal</span>
              <span class="text-sm font-semibold text-ink">Catalog Affinity & Customer Context</span>
            </div>
            <span class="font-mono text-xs font-medium px-2 py-0.5 rounded-[4px] bg-[#f0fdf4] text-[#15803d] border border-[#bbf7d0]">
              EXTRACTED
            </span>
          </div>
          <p class="text-xs text-body mb-3 font-mono leading-relaxed">{signalStage?.reason || 'Extracted affinities from catalog metadata'}</p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 font-mono text-xs text-body">
            <div class="bg-canvas p-2.5 rounded-[6px] border border-hairline">
              <span class="text-mute text-[10px] uppercase block">Customer Profile</span>
              <span class="text-ink font-semibold">{signalStage?.payload?.customer_tier || 'standard'} ({customer?.order_count} past orders)</span>
            </div>
            <div class="bg-canvas p-2.5 rounded-[6px] border border-hairline">
              <span class="text-mute text-[10px] uppercase block">Catalog Candidates</span>
              <span class="text-ink font-semibold">{signalStage?.payload?.candidate_count ?? 17} SKUs</span>
            </div>
            <div class="bg-canvas p-2.5 rounded-[6px] border border-hairline">
              <span class="text-mute text-[10px] uppercase block">Affinity Matches</span>
              <span class="text-[#0066FF] font-semibold">{signalStage?.payload?.affinity_matches?.length || 1} high-affinity pairing(s)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- STAGE 3: DECISION -->
    <div class="flex items-stretch gap-4 sm:gap-6 anime-stage-step">
      <div class="flex flex-col items-center flex-shrink-0 w-8">
        <div class="w-8 h-8 rounded-full bg-ink text-white font-mono text-xs font-bold flex items-center justify-center shadow-whisper z-10 flex-shrink-0">
          3
        </div>
        <div class="w-[2px] bg-hairline flex-1 my-1"></div>
      </div>

      <!-- Stage 3 Content Card -->
      <div class="flex-1 pb-8">
        <div class="bg-canvas-elevated border border-hairline rounded-md p-5 sm:p-6 shadow-whisper">
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-hairline">
            <div class="flex items-center space-x-2.5">
              <span class="font-mono text-[11px] uppercase text-mute tracking-wider font-semibold">Stage 03 · Decision Engine</span>
              <span class="text-sm font-semibold text-ink">Structured LLM Inference (Zod Validated)</span>
            </div>
            <span class="font-mono text-xs font-medium px-2 py-0.5 rounded-[4px] bg-canvas border border-hairline text-ink">
              SCHEMA VALIDATED
            </span>
          </div>

          {decisionStage ? (
            <div class="space-y-3 font-mono text-xs">
              <div class="bg-canvas p-4 rounded-[6px] border border-hairline">
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pb-3 mb-3 border-b border-hairline">
                  <div>
                    <span class="text-mute block text-[10px] uppercase">Action</span>
                    <span class="font-semibold text-ink">{decisionStage.payload.action}</span>
                  </div>
                  <div>
                    <span class="text-mute block text-[10px] uppercase">Recommended SKU</span>
                    <span class="font-semibold text-ink">{decisionStage.payload.recommended_sku || 'none'}</span>
                  </div>
                  <div>
                    <span class="text-mute block text-[10px] uppercase">Proposed Discount</span>
                    <span class={`font-semibold ${decisionStage.payload.discount_pct > 15 ? 'text-amber-600 font-bold' : 'text-ink'}`}>
                      {decisionStage.payload.discount_pct}%
                    </span>
                  </div>
                  <div>
                    <span class="text-mute block text-[10px] uppercase">Confidence Metric</span>
                    <span class={`font-semibold ${decisionStage.payload.confidence < 0.6 ? 'text-amber-600 font-bold' : 'text-ink'}`}>
                      {(decisionStage.payload.confidence * 100).toFixed(0)}%
                    </span>
                  </div>
                </div>

                <div>
                  <span class="text-mute text-[10px] uppercase block mb-1">Explainable AI Reasoning (Rubric G2):</span>
                  <p class="font-sans text-xs text-ink leading-relaxed italic bg-canvas-elevated p-3 rounded-[6px] border border-hairline">
                    "{decisionStage.reason}"
                  </p>
                </div>
              </div>
            </div>
          ) : (
            <p class="text-xs text-mute font-mono">No decision recorded.</p>
          )}
        </div>
      </div>
    </div>

    <!-- STAGE 4: GATE LAYER -->
    <div class="flex items-stretch gap-4 sm:gap-6 anime-stage-step">
      <div class="flex flex-col items-center flex-shrink-0 w-8">
        <div class:list={[
          'w-8 h-8 rounded-full font-mono text-xs font-bold flex items-center justify-center shadow-whisper z-10 flex-shrink-0',
          isAccepted ? 'bg-ink text-white' : 'bg-amber-600 text-white ring-4 ring-amber-100'
        ]}>
          4
        </div>
        <!-- Color matching connecting line down to stage 5 -->
        <div class:list={['w-[2px] flex-1 my-1', isAccepted ? 'bg-hairline' : 'bg-amber-300']}></div>
      </div>

      <!-- Stage 4 Content Card -->
      <div class="flex-1 pb-8">
        <div class={`rounded-md p-5 sm:p-6 border shadow-whisper ${isAccepted ? 'bg-canvas-elevated border-hairline' : 'bg-[#fffdfa] border-[#fde68a]'}`}>
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-hairline">
            <div class="flex items-center space-x-2.5">
              <span class="font-mono text-[11px] uppercase text-mute tracking-wider font-semibold">Stage 04 · Deterministic Gate</span>
              <span class="text-sm font-semibold text-ink">Boundary & Margin Shield (TRD §5)</span>
            </div>
            {isAccepted ? (
              <span class="font-mono text-xs font-semibold px-2.5 py-0.5 rounded-full bg-[#f0fdf4] text-[#15803d] border border-[#bbf7d0]">
                ✓ PASSED ALL BOUNDS
              </span>
            ) : (
              <span class="font-mono text-xs font-semibold px-2.5 py-0.5 rounded-full bg-[#fffbeb] text-[#b45309] border border-[#fde68a]">
                ✕ BOUND VIOLATION ENFORCED
              </span>
            )}
          </div>

          <div class="mt-2">
            <div class="text-[11px] uppercase font-mono text-mute mb-1">Gate Evaluation Result:</div>
            <p class={`text-xs font-medium p-3 rounded-[6px] border font-mono leading-relaxed ${isAccepted ? 'bg-canvas text-ink border-hairline' : 'bg-[#fffbeb] text-[#92400e] border-[#fde68a]'}`}>
              {gateStage?.reason || 'Evaluation complete'}
            </p>
          </div>

          <!-- 5-Rule Verification Checklist -->
          <div class="mt-4 pt-3 border-t border-hairline">
            <div class="font-mono text-[10px] uppercase text-mute tracking-wider mb-2">Deterministic Rules Checklist:</div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono">
              
              <div class="bg-canvas p-2.5 rounded-[6px] border border-hairline flex items-center justify-between">
                <div>
                  <span class="text-mute block text-[10px]">Rule 1: Max Discount (≤15%)</span>
                  <span class="text-ink">Evaluated: {discountVal}%</span>
                </div>
                <span class={rule1Pass ? 'text-emerald-600 font-bold' : 'text-amber-600 font-bold'}>
                  {rule1Pass ? '✓ PASSED' : '✕ VIOLATED'}
                </span>
              </div>

              <div class="bg-canvas p-2.5 rounded-[6px] border border-hairline flex items-center justify-between">
                <div>
                  <span class="text-mute block text-[10px]">Rule 2: Single Offer Idempotency</span>
                  <span class="text-ink">Prior Offer Check</span>
                </div>
                <span class={gateStage?.ruleViolated === 'one_offer_per_order' ? 'text-amber-600 font-bold' : 'text-emerald-600 font-bold'}>
                  {gateStage?.ruleViolated === 'one_offer_per_order' ? '✕ DUPLICATE' : '✓ UNIQUE'}
                </span>
              </div>

              <div class="bg-canvas p-2.5 rounded-[6px] border border-hairline flex items-center justify-between">
                <div>
                  <span class="text-mute block text-[10px]">Rule 3: Order Eligibility</span>
                  <span class="text-ink">Status: {order.status}</span>
                </div>
                <span class={rule3Pass ? 'text-emerald-600 font-bold' : 'text-amber-600 font-bold'}>
                  {rule3Pass ? '✓ ELIGIBLE' : '✕ INELIGIBLE'}
                </span>
              </div>

              <div class="bg-canvas p-2.5 rounded-[6px] border border-hairline flex items-center justify-between">
                <div>
                  <span class="text-mute block text-[10px]">Rule 4: Confidence Metric (≥0.60)</span>
                  <span class="text-ink">Score: {(confVal * 100).toFixed(0)}%</span>
                </div>
                <span class={rule4Pass ? 'text-emerald-600 font-bold' : 'text-amber-600 font-bold'}>
                  {rule4Pass ? '✓ CONFIDENT' : '✕ LOW CONF'}
                </span>
              </div>

            </div>
          </div>

          {isRejected && (
            <div class="mt-3.5 p-3 rounded-[6px] bg-canvas border border-hairline text-xs text-body flex items-center space-x-2">
              <span class="text-ink font-bold inline-flex items-center space-x-1.5">
                <Icon name="shield-alert" class="w-4 h-4 text-amber-600 flex-shrink-0" />
                <span>Safety Invariant:</span>
              </span>
              <span>Money operations halted safely before Razorpay API was reached. Margin preserved.</span>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- STAGE 5: EXECUTION -->
    {isAccepted ? (
      <div class="flex items-stretch gap-4 sm:gap-6 anime-stage-step">
        <div class="flex flex-col items-center flex-shrink-0 w-8">
          <div class="w-8 h-8 rounded-full bg-emerald-600 text-white font-mono text-xs font-bold flex items-center justify-center shadow-whisper ring-4 ring-emerald-100 z-10 flex-shrink-0">
            5
          </div>
          <!-- Terminal Node: No further line below -->
        </div>

        <div class="flex-1 pb-2">
          <div class="bg-canvas-elevated border border-hairline rounded-md p-5 sm:p-6 shadow-whisper">
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-hairline">
              <div class="flex items-center space-x-2.5">
                <span class="font-mono text-[11px] uppercase text-mute tracking-wider font-semibold">Stage 05 · Execution</span>
                <span class="text-sm font-semibold text-ink">Razorpay Payment Links API</span>
              </div>
              <span class="font-mono text-xs font-semibold px-2 py-0.5 rounded-[4px] bg-[#f0fdf4] text-[#15803d] border border-[#bbf7d0]">
                LINK GENERATED
              </span>
            </div>

            <p class="text-xs text-body mb-3 font-mono">{executionStage?.reason || 'Payment link generated'}</p>

            <div id="payment-link-card" class="bg-canvas p-4 rounded-[6px] border border-hairline space-y-3 font-mono text-xs">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-hairline">
                <div>
                  <div class="flex items-center space-x-2">
                    <span class="text-mute text-[10px] uppercase block">Payment Link URL:</span>
                    {executionStage?.payload?.short_url?.includes('plink_test') && (
                      <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-600 border border-amber-500/20 font-semibold">
                        Demo Sandbox Link
                      </span>
                    )}
                  </div>
                  <div class="flex items-center space-x-2 mt-1">
                    <button
                      type="button"
                      onclick="openCheckoutModal()"
                      class="text-[#0066FF] hover:underline font-semibold flex items-center space-x-1 text-sm cursor-pointer text-left"
                    >
                      <span class="truncate max-w-[260px] sm:max-w-[340px]">{executionStage?.payload?.short_url || 'https://rzp.io/rzp/test'}</span>
                      <span>↗</span>
                    </button>
                    <a
                      href={executionStage?.payload?.short_url || '#'}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[10px] text-mute hover:text-ink underline ml-1"
                      title="Open external URL directly on rzp.io (Note: mock IDs return 404 on live rzp.io servers)"
                    >
                      (Raw rzp.io)
                    </a>
                  </div>
                </div>
                <div class="sm:text-right">
                  <span class="text-mute text-[10px] uppercase block">Discounted Amount:</span>
                  <span class="text-base font-bold text-ink">
                    ₹{executionStage?.payload?.amount?.toLocaleString() || '0'}
                  </span>
                </div>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-3 pt-1 text-[11px] text-mute">
                <div>Reference ID: <span class="text-ink font-semibold">{executionStage?.payload?.reference_id}</span></div>
                <div class="flex items-center space-x-2">
                  <span>Status: <strong id="link-status-badge" class="text-ink uppercase">{executionStage?.payload?.status || 'created'}</strong></span>
                  <button
                    id="copy-link-btn"
                    onclick={`
                      navigator.clipboard.writeText('${executionStage?.payload?.short_url || ''}');
                      const btn = document.getElementById('copy-link-btn');
                      btn.innerText = 'Copied!';
                      setTimeout(() => btn.innerText = 'Copy URL', 1500);
                    `}
                    class="h-7 px-3 rounded-[6px] bg-canvas-elevated border border-hairline text-ink hover:bg-hairline-soft font-medium transition cursor-pointer shadow-whisper inline-flex items-center space-x-1"
                  >
                    Copy URL
                  </button>
                  <button
                    type="button"
                    onclick="openCheckoutModal()"
                    class="h-7 px-3 rounded-[6px] bg-[#0066FF] text-white hover:bg-[#0052CC] font-medium transition cursor-pointer shadow-whisper inline-flex items-center space-x-1"
                  >
                    <span>Preview Checkout</span>
                    <span>↗</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="flex items-stretch gap-4 sm:gap-6 anime-stage-step opacity-70">
        <div class="flex flex-col items-center flex-shrink-0 w-8">
          <div class="w-8 h-8 rounded-full bg-hairline-soft text-mute border border-hairline font-mono text-xs font-semibold flex items-center justify-center shadow-whisper z-10 flex-shrink-0">
            5
          </div>
        </div>

        <div class="flex-1 pb-2">
          <div class="bg-canvas-elevated border border-hairline rounded-md p-5 shadow-whisper">
            <div class="flex items-center justify-between">
              <span class="font-mono text-[11px] uppercase text-mute">Stage 05 · Execution</span>
              <span class="font-mono text-xs text-mute font-medium">SKIPPED (GATED)</span>
            </div>
            <p class="text-xs text-mute mt-1">Payment link generation blocked by deterministic gate to preserve merchant profit margins.</p>
          </div>
        </div>
      </div>
    )}

  </div>

  <!-- Interactive Razorpay Checkout Sandbox Modal -->
  <div id="checkout-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full overflow-hidden border border-slate-200">
      
      <!-- Razorpay Branded Top Header -->
      <div class="bg-[#0c2340] text-white px-5 py-4 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-lg bg-[#0066FF] flex items-center justify-center font-bold text-white text-base">
            ₹
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <span class="font-semibold text-sm tracking-tight text-white">Razorpay Standard Checkout</span>
              <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-amber-400 text-[#0c2340] font-black uppercase tracking-wider">Test Mode</span>
            </div>
            <p class="text-[11px] text-slate-300">Apex Electronics · Secured by Razorpay</p>
          </div>
        </div>
        <button
          type="button"
          onclick="closeCheckoutModal()"
          class="text-slate-400 hover:text-white transition p-1 text-xl leading-none cursor-pointer"
          aria-label="Close"
        >
          &times;
        </button>
      </div>

      <!-- Order & Pricing Summary -->
      <div class="p-5 bg-slate-50 border-b border-slate-200">
        <div class="flex items-start justify-between">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-wider text-slate-500 font-semibold">Upsell Add-On Offer</span>
            <h4 class="font-bold text-slate-900 text-sm mt-0.5">{decisionStage?.payload?.recommended_name || 'Recommended Upgrade'}</h4>
            <div class="text-xs text-slate-600 font-mono mt-0.5">SKU: {decisionStage?.payload?.recommended_sku || 'SKU-OFFER'}</div>
          </div>
          <div class="text-right">
            <span class="text-[10px] font-mono uppercase tracking-wider text-slate-500 font-semibold">Amount to Pay</span>
            <div class="text-xl font-extrabold text-slate-900 font-mono">
              ₹{executionStage?.payload?.amount?.toLocaleString() || '0'}
            </div>
            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold">
              {decisionStage?.payload?.discount_pct || 10}% OFF APPLIED
            </span>
          </div>
        </div>
        
        <div class="mt-3 pt-3 border-t border-slate-200/80 flex items-center justify-between text-[11px] text-slate-600 font-mono">
          <span>Customer: {customer?.name || 'Valued Customer'}</span>
          <span>Order Ref: {order.id.slice(0, 14)}</span>
        </div>
      </div>

      <!-- Payment Method Simulation -->
      <div class="p-5 space-y-4">
        <!-- Initial Form State -->
        <div id="checkout-form-state" class="space-y-3">
          <span class="text-[11px] font-semibold text-slate-700 font-mono uppercase tracking-wider block">Select Payment Method</span>
          
          <div class="space-y-2 text-xs">
            <label class="flex items-center justify-between p-3 rounded-lg border border-[#0066FF] bg-blue-50/50 cursor-pointer">
              <div class="flex items-center space-x-2.5">
                <input type="radio" name="sim-payment" checked class="text-[#0066FF] focus:ring-0" />
                <span class="font-semibold text-slate-800">UPI Instant (GPay / PhonePe / Paytm)</span>
              </div>
              <span class="text-[10px] font-mono text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded font-bold">Fastest</span>
            </label>

            <label class="flex items-center justify-between p-3 rounded-lg border border-slate-200 hover:border-slate-300 bg-white cursor-pointer">
              <div class="flex items-center space-x-2.5">
                <input type="radio" name="sim-payment" class="text-[#0066FF] focus:ring-0" />
                <span class="font-medium text-slate-700">Cards (Visa, Mastercard, RuPay)</span>
              </div>
              <span class="text-[10px] font-mono text-slate-400">•••• 4242</span>
            </label>

            <label class="flex items-center justify-between p-3 rounded-lg border border-slate-200 hover:border-slate-300 bg-white cursor-pointer">
              <div class="flex items-center space-x-2.5">
                <input type="radio" name="sim-payment" class="text-[#0066FF] focus:ring-0" />
                <span class="font-medium text-slate-700">Netbanking (HDFC, ICICI, SBI)</span>
              </div>
              <span class="text-[10px] font-mono text-slate-400">All Banks</span>
            </label>
          </div>

          <button
            type="button"
            id="btn-simulate-pay"
            onclick="simulatePaymentSuccess()"
            class="w-full mt-3 h-11 rounded-lg bg-[#0066FF] hover:bg-[#0052CC] text-white font-semibold text-sm transition shadow-md flex items-center justify-center space-x-2 cursor-pointer"
          >
            <span id="sim-pay-spinner" class="hidden animate-spin">◌</span>
            <span id="sim-pay-label">Simulate Payment (₹{executionStage?.payload?.amount?.toLocaleString() || '0'})</span>
          </button>
        </div>

        <!-- Success Result State -->
        <div id="checkout-success-state" class="hidden text-center py-4 space-y-3">
          <div class="w-14 h-14 mx-auto rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-2xl font-bold shadow-sm">
            ✓
          </div>
          <div>
            <h3 class="text-base font-bold text-slate-900">Payment Completed Successfully!</h3>
            <p class="text-xs text-slate-600 mt-1 font-mono">Simulated Razorpay ID: <span id="sim-payment-id" class="font-bold text-slate-800">pay_sim_success</span></p>
          </div>
          <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-left text-[11px] font-mono text-emerald-800 space-y-1">
            <div class="font-bold flex items-center space-x-1">
              <span>●</span>
              <span>Webhook Dispatched: payment.captured</span>
            </div>
            <div>Order: {order.id}</div>
            <div>Upsell item SKU added to customer order manifest.</div>
          </div>
          <button
            type="button"
            onclick="closeCheckoutModal()"
            class="px-5 h-9 rounded-lg bg-slate-900 text-white text-xs font-semibold hover:bg-slate-800 transition cursor-pointer"
          >
            Back to Order Trail
          </button>
        </div>

        <!-- Diagnostic & Architecture Note -->
        <div class="pt-3 border-t border-slate-200 text-[11px] text-slate-500 space-y-1.5">
          <div class="flex items-center space-x-1.5 font-semibold text-slate-700">
            <span class="text-amber-500">ℹ️</span>
            <span>Why simulated in offline/standalone demo?</span>
          </div>
          <p class="leading-relaxed">
            Razorpay's live domain (<code>https://rzp.io</code>) returns <strong>404 Not Found</strong> for synthetic links because mock IDs only exist in local memory/seed data. In live production with <code>RAZORPAY_KEY_ID</code> configured, real payment links are registered on Razorpay's API and load directly on <code>rzp.io</code>.
          </p>
          <div class="pt-1 flex items-center justify-between">
            <span class="font-mono text-[10px] text-slate-400">Link ID: {executionStage?.payload?.payment_link_id || 'plink_demo'}</span>
            <a
              href={executionStage?.payload?.short_url || '#'}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-[10px] text-[#0066FF] hover:underline"
            >
              Open raw rzp.io link ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    function openCheckoutModal() {
      const modal = document.getElementById('checkout-modal');
      if (modal) modal.classList.remove('hidden');
    }

    function closeCheckoutModal() {
      const modal = document.getElementById('checkout-modal');
      if (modal) modal.classList.add('hidden');
    }

    // Close on backdrop click
    document.getElementById('checkout-modal')?.addEventListener('click', (e) => {
      if (e.target.id === 'checkout-modal') closeCheckoutModal();
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeCheckoutModal();
    });

    // Auto-open if query param ?preview=checkout is present
    if (new URLSearchParams(window.location.search).get('preview') === 'checkout') {
      setTimeout(openCheckoutModal, 300);
    }

    // Simulate payment completion
    function simulatePaymentSuccess() {
      const spinner = document.getElementById('sim-pay-spinner');
      const label = document.getElementById('sim-pay-label');
      const btn = document.getElementById('btn-simulate-pay');
      
      if (spinner) spinner.classList.remove('hidden');
      if (label) label.innerText = 'Processing with Razorpay...';
      if (btn) btn.disabled = true;

      setTimeout(() => {
        const formState = document.getElementById('checkout-form-state');
        const successState = document.getElementById('checkout-success-state');
        const simIdEl = document.getElementById('sim-payment-id');
        const statusBadge = document.getElementById('link-status-badge');

        const mockPayId = 'pay_' + Math.random().toString(36).substring(2, 10);
        if (simIdEl) simIdEl.innerText = mockPayId;
        if (formState) formState.classList.add('hidden');
        if (successState) successState.classList.remove('hidden');

        // Update badge on background page to PAID
        if (statusBadge) {
          statusBadge.innerText = 'PAID';
          statusBadge.className = 'text-emerald-600 font-bold uppercase';
        }
      }, 900);
    }
  </script>
</Layout>
