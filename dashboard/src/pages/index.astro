---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { fetchBatchSummary, fetchOrders } from '../lib/api';

const summary = await fetchBatchSummary();
const orders = await fetchOrders();
const recentOrders = orders.slice(0, 8);

const totalEvaluated = (summary.offers_accepted + summary.offers_rejected) || 1;
const acceptancePct = Math.round((summary.offers_accepted / totalEvaluated) * 100);
const rejectionPct = 100 - acceptancePct;
---

<Layout title="Batch Summary" activeNav="summary">
  <!-- Subtle Hero Mesh Gradient -->
  <div class="hero-mesh-gradient"></div>

  <!-- Hero Section with anime-hero-fade classes -->
  <div class="relative z-10 pt-2 pb-10 space-y-4">
    <!-- Technical Eyebrow -->
    <div class="anime-hero-fade inline-flex items-center space-x-2 font-mono text-xs uppercase text-mute tracking-wider px-3 py-1 rounded-[6px] bg-canvas-elevated border border-hairline shadow-whisper">
      <span class="w-1.5 h-1.5 rounded-full bg-[#0066FF]"></span>
      <span>UpsellX AI · Autonomous Agentic Commerce Engine</span>
    </div>

    <!-- Display Headline -->
    <h1 class="anime-hero-fade text-3xl sm:text-5xl font-semibold text-ink tracking-[-2px] leading-tight max-w-3xl">
      Autonomous Upsell & Cross-Sell Engine
    </h1>

    <!-- Subtitle -->
    <p class="anime-hero-fade text-body text-sm sm:text-base max-w-2xl font-normal leading-relaxed">
      Continuous agent pipeline monitoring Razorpay merchant orders. Leveraging LLMs for intelligent co-purchase recommendations, shielded by deterministic margin gates before touching any money API.
    </p>

    <!-- Quick Action Bar -->
    <div class="anime-hero-fade flex flex-wrap items-center gap-3 pt-2">
      <a
        href="/orders"
        class="h-9 px-4 rounded-pill bg-ink text-white text-xs font-medium hover:bg-[#2e2e2e] transition shadow-whisper inline-flex items-center space-x-2 cursor-pointer whitespace-nowrap"
      >
        <span>Explore All 15 Order Trails</span>
        <span>&rarr;</span>
      </a>
      <a
        href="/failures"
        class="h-9 px-4 rounded-pill bg-white text-ink border border-[#d4d4d4] hover:border-ink/60 text-xs font-medium hover:bg-[#f5f5f5] transition shadow-whisper inline-flex items-center space-x-2 cursor-pointer whitespace-nowrap"
      >
        <span>Inspect Handled Failure Log</span>
        <span class="w-1.5 h-1.5 rounded-full bg-error flex-shrink-0"></span>
      </a>
      <button
        onclick="triggerLiveBatch()"
        class="h-9 px-4 rounded-pill bg-white text-ink border border-[#d4d4d4] hover:border-ink/60 hover:bg-[#f5f5f5] text-xs font-medium transition shadow-whisper inline-flex items-center space-x-2 cursor-pointer whitespace-nowrap"
      >
        <Icon name="zap" class="w-3.5 h-3.5 text-amber-500 flex-shrink-0" />
        <span>Re-Run Pipeline</span>
      </button>
    </div>
  </div>

  <!-- KPI Row: 5 Hairline Feature Cards with anime-card-enter & anime-counter -->
  <div class="grid grid-cols-2 md:grid-cols-5 gap-3.5 mb-10 relative z-10">
    <!-- 1. Processed Orders -->
    <div class="anime-card-enter bg-canvas-elevated border border-hairline rounded-md p-5 shadow-whisper">
      <div class="font-mono text-[11px] uppercase text-mute tracking-wider">Processed Orders</div>
      <div class="text-3xl font-semibold text-ink mt-2 tracking-tight anime-counter" data-target={summary.total_orders}>
        {summary.total_orders}
      </div>
      <div class="text-[11px] text-mute mt-1">100% automated batch</div>
    </div>

    <!-- 2. Offers Formulated -->
    <div class="anime-card-enter bg-canvas-elevated border border-hairline rounded-md p-5 shadow-whisper">
      <div class="font-mono text-[11px] uppercase text-mute tracking-wider">Offers Formulated</div>
      <div class="text-3xl font-semibold text-ink mt-2 tracking-tight anime-counter" data-target={summary.offers_made}>
        {summary.offers_made}
      </div>
      <div class="text-[11px] text-mute mt-1">Zod-validated decisions</div>
    </div>

    <!-- 3. Gate Accepted -->
    <div class="anime-card-enter bg-canvas-elevated border border-hairline rounded-md p-5 shadow-whisper">
      <div class="font-mono text-[11px] uppercase text-mute tracking-wider flex items-center justify-between">
        <span>Gate Approved</span>
        <span class="font-mono text-[10px] text-emerald-600 font-semibold">{acceptancePct}%</span>
      </div>
      <div class="text-3xl font-semibold text-ink mt-2 tracking-tight anime-counter" data-target={summary.offers_accepted}>
        {summary.offers_accepted}
      </div>
      <div class="text-[11px] text-mute mt-1">Met margin & SKU bounds</div>
    </div>

    <!-- 4. Gate Blocked -->
    <div class="anime-card-enter bg-canvas-elevated border border-hairline rounded-md p-5 shadow-whisper">
      <div class="font-mono text-[11px] uppercase text-mute tracking-wider flex items-center justify-between">
        <span>Gate Blocked</span>
        <span class="font-mono text-[10px] text-amber-600 font-semibold">{rejectionPct}%</span>
      </div>
      <div class="text-3xl font-semibold text-ink mt-2 tracking-tight anime-counter" data-target={summary.offers_rejected}>
        {summary.offers_rejected}
      </div>
      <div class="text-[11px] text-mute mt-1">Deterministic margin guard</div>
    </div>

    <!-- 5. Handled Failures -->
    <a
      href="/failures"
      class="anime-card-enter group bg-canvas-elevated border border-hairline hover:border-[#d4d4d4] rounded-md p-5 shadow-whisper transition block cursor-pointer"
    >
      <div class="font-mono text-[11px] uppercase text-mute tracking-wider flex items-center justify-between">
        <span>Failures Handled</span>
        <span class="w-1.5 h-1.5 rounded-full bg-error"></span>
      </div>
      <div class="text-3xl font-semibold text-error mt-2 tracking-tight anime-counter" data-target={summary.failures_handled}>
        {summary.failures_handled}
      </div>
      <div class="text-[11px] text-mute mt-1 flex items-center justify-between">
        <span>Zero retry-storm</span>
        <span class="group-hover:translate-x-0.5 transition-transform text-ink">&rarr;</span>
      </div>
    </a>
  </div>

  <!-- 2-Column Analytical Section -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-10">
    <!-- Left 2 Cols: Deterministic Gate Breakdown with Animated Anime.js Meters -->
    <div class="anime-card-enter lg:col-span-2 bg-canvas-elevated border border-hairline rounded-md p-6 shadow-whisper">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-hairline gap-2">
        <div>
          <div class="font-mono text-[11px] uppercase text-mute tracking-wider">Safety Enforcement Analysis</div>
          <h2 class="text-base font-semibold text-ink tracking-tight mt-0.5">
            Deterministic Gate Shield Defense (TRD §5)
          </h2>
        </div>
        <span class="font-mono text-[11px] px-2.5 py-0.5 rounded-[4px] bg-canvas border border-hairline text-ink font-medium self-start">
          Zero LLM Control Over Bounds
        </span>
      </div>

      <p class="text-body text-xs mt-3 mb-5 leading-relaxed">
        To prevent margin leakage and broken customer experiences, every AI recommendation is gated against hard deterministic bounds. All rejections are permanently logged:
      </p>

      <!-- Visual Rejection Bars with anime-meter-fill -->
      <div class="space-y-3">
        {Object.entries(summary.rejection_reasons).map(([reason, count]) => (
          <div class="p-3.5 rounded-[6px] bg-canvas border border-hairline space-y-2">
            <div class="flex items-center justify-between text-xs">
              <div class="flex items-center space-x-2">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                <span class="font-mono text-ink text-xs font-medium">{reason}</span>
              </div>
              <span class="font-mono text-[11px] text-mute font-semibold">
                {count} {count === 1 ? 'case' : 'cases'}
              </span>
            </div>
            <!-- Proportional animated meter bar -->
            <div class="w-full bg-hairline-soft h-1.5 rounded-full overflow-hidden">
              <div
                class="anime-meter-fill bg-amber-500 h-full rounded-full"
                style={`width: ${(count / summary.offers_rejected) * 100}%`}
              ></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Right 1 Col: Rubric Defense Checklist -->
    <div class="anime-card-enter bg-canvas-elevated border border-hairline rounded-md p-6 shadow-whisper flex flex-col justify-between">
      <div>
        <div class="font-mono text-[11px] uppercase text-mute tracking-wider">Buildathon Rubric Verification</div>
        <h3 class="text-base font-semibold text-ink tracking-tight mt-0.5 mb-4">Evaluated Criteria</h3>

        <ul class="space-y-3 text-xs text-body">
          <li class="flex items-start space-x-2.5 pb-2.5 border-b border-hairline">
            <span class="text-ink font-bold font-mono">G1</span>
            <div>
              <strong class="text-ink">Revenue Growth Automation:</strong>
              <p class="text-mute mt-0.5">Runs unattended across 15 synthetic orders with realistic affinity mappings.</p>
            </div>
          </li>
          <li class="flex items-start space-x-2.5 pb-2.5 border-b border-hairline">
            <span class="text-ink font-bold font-mono">G2</span>
            <div>
              <strong class="text-ink">Explainable Decisions:</strong>
              <p class="text-mute mt-0.5">100% of decisions include structured JSON justification and confidence metrics.</p>
            </div>
          </li>
          <li class="flex items-start space-x-2.5 pb-2.5 border-b border-hairline">
            <span class="text-ink font-bold font-mono">G3</span>
            <div>
              <strong class="text-ink">Bounded & Gated:</strong>
              <p class="text-mute mt-0.5">Pure deterministic function enforces ≤15% discount cap and single-offer idempotency.</p>
            </div>
          </li>
          <li class="flex items-start space-x-2.5">
            <span class="text-ink font-bold font-mono">G4</span>
            <div>
              <strong class="text-ink">Graceful Failure Handling:</strong>
              <p class="text-mute mt-0.5">Payment link expiry terminates safely with 0 retries, preventing runaway loops.</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="pt-4 mt-4 border-t border-hairline">
        <a
          href="/orders"
          class="flex items-center justify-between text-xs font-semibold text-ink hover:text-body transition cursor-pointer"
        >
          <span>Explore Detailed Decision Trails</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Recent Orders Table -->
  <div class="anime-card-enter bg-canvas-elevated border border-hairline rounded-md overflow-hidden shadow-whisper">
    <div class="px-6 py-4 border-b border-hairline flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-canvas">
      <div>
        <div class="font-mono text-[11px] uppercase text-mute tracking-wider">Live Activity Feed</div>
        <h3 class="text-sm font-semibold text-ink">Recent Processed Orders</h3>
      </div>
      <div class="flex items-center space-x-2">
        <a
          href="/orders"
          class="h-7 px-3 rounded-[6px] bg-canvas-elevated border border-hairline text-ink hover:bg-hairline-soft text-xs font-medium transition inline-flex items-center space-x-1 cursor-pointer"
        >
          <span>View All 15 Orders</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-body">
        <thead class="bg-canvas border-b border-hairline font-mono uppercase text-mute text-[10px] tracking-wider">
          <tr>
            <th class="px-6 py-3 font-medium">Order ID</th>
            <th class="px-6 py-3 font-medium">Customer Profile</th>
            <th class="px-6 py-3 font-medium">Order Value</th>
            <th class="px-6 py-3 font-medium">AI Recommendation</th>
            <th class="px-6 py-3 font-medium">Gate Shield Outcome</th>
            <th class="px-6 py-3 text-right font-medium">Timeline</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {recentOrders.map((o: any) => (
            <tr class="hover:bg-canvas transition">
              <td class="px-6 py-3.5 font-mono text-ink">
                <a href={`/orders/${o.id}`} class="hover:underline font-medium cursor-pointer">
                  {o.id}
                </a>
              </td>
              <td class="px-6 py-3.5">
                <span class="text-ink font-medium block">{o.customer_name}</span>
                <span class="text-[10px] font-mono text-mute">
                  {o.customer_order_count > 2 ? (
                    <span class="inline-flex items-center space-x-1 text-amber-600 font-medium">
                      <Icon name="star" class="w-2.5 h-2.5 fill-amber-500 stroke-amber-500" />
                      <span>Repeat Buyer</span>
                    </span>
                  ) : (
                    <span>First-time Customer</span>
                  )}
                </span>
              </td>
              <td class="px-6 py-3.5 font-mono text-ink font-semibold">
                ₹{o.total_amount.toLocaleString()}
              </td>
              <td class="px-6 py-3.5 font-mono">
                {o.action === 'cross_sell' && (
                  <span class="px-2 py-0.5 rounded-[4px] bg-hairline-soft text-ink text-[11px] border border-hairline font-medium">
                    cross_sell · {o.recommended_sku}
                  </span>
                )}
                {o.action === 'upsell' && (
                  <span class="px-2 py-0.5 rounded-[4px] bg-hairline-soft text-ink text-[11px] border border-hairline font-medium">
                    upsell · {o.recommended_sku}
                  </span>
                )}
                {o.action === 'none' && (
                  <span class="px-2 py-0.5 rounded-[4px] bg-canvas text-mute text-[11px] border border-hairline">
                    none
                  </span>
                )}
              </td>
              <td class="px-6 py-3.5">
                {o.gate_result === 'accepted' ? (
                  <span class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-[#f0fdf4] text-[#15803d] border border-[#bbf7d0]">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#16a34a]"></span>
                    <span>Passed Bounds</span>
                  </span>
                ) : (
                  <span class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-[#fffbeb] text-[#b45309] border border-[#fde68a]">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
                    <span>Blocked: {o.gate_reason?.slice(0, 24)}...</span>
                  </span>
                )}
              </td>
              <td class="px-6 py-3.5 text-right">
                <a
                  href={`/orders/${o.id}`}
                  class="text-xs text-ink hover:underline font-medium inline-flex items-center space-x-1 cursor-pointer"
                >
                  <span>Audit Trail</span>
                  <span>&rarr;</span>
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Layout>
