---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sign In · RazorPulse AI" isProtected={false} activeNav="">
  <div class="min-h-[75vh] flex items-center justify-center py-10 px-4">
    <div class="w-full max-w-md space-y-6">

      <!-- Header & Branding -->
      <div class="text-center space-y-2">
        <div class="inline-flex items-center space-x-2.5 mb-2 select-none">
          <div class="w-10 h-10 flex-shrink-0 flex items-center justify-center">
            <svg viewBox="0 0 36 36" fill="none" class="w-full h-full">
              <rect width="36" height="36" rx="8" fill="#0C1527" stroke="#1E293B" stroke-width="1"></rect>
              <path d="M9 25L17 7H24L16 25H9Z" fill="#0066FF"></path>
              <path d="M17 29L22 17H28L23 29H17Z" fill="#38BDF8"></path>
              <circle cx="26" cy="10" r="2.5" fill="#38BDF8"></circle>
            </svg>
          </div>
          <span class="text-2xl font-bold text-ink tracking-tight">
            Razor<span class="text-[#0066FF]">Pulse</span> <span class="text-xs font-mono font-semibold px-1.5 py-0.5 rounded bg-[#0066FF]/10 text-[#0066FF] border border-[#0066FF]/20 align-middle">AI</span>
          </span>
        </div>
        <h1 class="text-2xl font-semibold text-ink tracking-tight">Welcome back</h1>
        <p class="text-body text-xs sm:text-sm">
          Sign in to your merchant dashboard to inspect order trails and gate defenses.
        </p>
      </div>

      <!-- Quick 1-Click Demo Login for Buildathon Evaluators -->
      <div class="bg-canvas-elevated border border-hairline rounded-md p-4 shadow-whisper space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-xs font-mono uppercase tracking-wider text-ink font-semibold">Judge & Demo Quick Access</span>
          </div>
          <span class="text-[10px] font-mono text-mute">1-Click</span>
        </div>
        <p class="text-xs text-body">
          Pre-authenticated session for <strong>Apex Electronics & Tech Gear</strong> (<code class="font-mono text-ink">demo@razorpulse.ai</code>).
        </p>
        <button
          type="button"
          id="btn-quick-demo"
          onclick="handleQuickDemoLogin()"
          class="w-full h-9 rounded-[6px] bg-ink hover:bg-[#2a2a2a] text-white text-xs font-medium transition shadow-whisper cursor-pointer flex items-center justify-center space-x-2"
        >
          <span>⚡</span>
          <span>One-Click Demo Login (Apex Admin)</span>
        </button>
      </div>

      <div class="relative flex items-center justify-center">
        <div class="border-t border-hairline w-full"></div>
        <span class="bg-canvas px-3 text-[11px] font-mono text-mute uppercase tracking-wider absolute">or sign in with email</span>
      </div>

      <!-- Main Login Form -->
      <div class="bg-canvas-elevated border border-hairline rounded-md p-6 shadow-whisper space-y-5">
        
        <!-- Error Alert (hidden by default) -->
        <div id="auth-error-box" class="hidden p-3 rounded-[6px] bg-[#fef2f2] border border-[#fecaca] text-[#b91c1c] text-xs font-mono">
          <div class="flex items-center space-x-2">
            <span>✕</span>
            <span id="auth-error-msg">Invalid credentials</span>
          </div>
        </div>

        <form id="login-form" onsubmit="handleEmailLogin(event)" class="space-y-4 text-left">
          <div class="space-y-1.5">
            <label for="email" class="block font-mono text-xs font-medium text-ink">Merchant Business Email</label>
            <input
              type="email"
              id="email"
              name="email"
              value="demo@razorpulse.ai"
              required
              class="w-full h-10 px-3.5 rounded-[6px] bg-canvas border border-hairline text-xs font-mono text-ink placeholder:text-mute focus:outline-none focus:border-ink transition shadow-whisper"
              placeholder="name@store.com"
            />
          </div>

          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label for="password" class="block font-mono text-xs font-medium text-ink">Password</label>
              <span class="text-[11px] font-mono text-mute">Default: <code class="text-ink">buildathon2026</code></span>
            </div>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                value="buildathon2026"
                required
                class="w-full h-10 pl-3.5 pr-10 rounded-[6px] bg-canvas border border-hairline text-xs font-mono text-ink placeholder:text-mute focus:outline-none focus:border-ink transition shadow-whisper"
                placeholder="••••••••"
              />
              <button
                type="button"
                onclick="togglePasswordVisibility()"
                class="absolute right-3 top-2.5 text-mute hover:text-ink text-xs font-mono cursor-pointer"
              >
                <span id="eye-icon">👁️</span>
              </button>
            </div>
          </div>

          <div class="flex items-center justify-between text-xs pt-1">
            <label class="flex items-center space-x-2 text-body cursor-pointer">
              <input type="checkbox" id="remember-me" checked class="rounded border-hairline text-ink focus:ring-ink" />
              <span>Remember this device</span>
            </label>
            <a href="/terms" class="text-xs text-[#0066FF] hover:underline">BYOK Terms</a>
          </div>

          <button
            type="submit"
            id="btn-submit"
            class="w-full h-10 rounded-[6px] bg-[#0066FF] hover:bg-[#0052CC] text-white text-xs font-medium transition shadow-whisper cursor-pointer flex items-center justify-center space-x-2"
          >
            <span id="submit-text">Sign In to Dashboard</span>
            <span id="submit-spinner" class="hidden animate-spin">◌</span>
          </button>
        </form>

        <div class="pt-4 border-t border-hairline text-center text-xs text-mute">
          Don't have a merchant account?
          <a href="/signup" class="text-ink font-semibold hover:underline ml-1">Register store &rarr;</a>
        </div>
      </div>

      <!-- Trust Footer Info -->
      <div class="text-center text-[11px] font-mono text-mute space-y-1">
        <div>Non-Custodial Direct Settlement via Razorpay API</div>
        <div>
          <a href="/privacy" class="hover:underline">Privacy</a>
          <span>·</span>
          <a href="/terms" class="hover:underline">Terms</a>
          <span>·</span>
          <a href="/security" class="hover:underline">Security</a>
        </div>
      </div>

    </div>
  </div>

  <script is:inline>
    // Toggle password visibility
    function togglePasswordVisibility() {
      const pwd = document.getElementById('password');
      const eye = document.getElementById('eye-icon');
      if (pwd.type === 'password') {
        pwd.type = 'text';
        eye.innerText = '🙈';
      } else {
        pwd.type = 'password';
        eye.innerText = '👁️';
      }
    }

    // Get redirect URL parameter
    function getRedirectUrl() {
      const params = new URLSearchParams(window.location.search);
      return params.get('redirect') || '/';
    }

    // Set user session in localStorage and cookie
    function saveSession(token, user) {
      localStorage.setItem('razorpulse_auth_token', token);
      localStorage.setItem('razorpulse_auth_user', JSON.stringify(user));
      document.cookie = `razorpulse_auth_token=${encodeURIComponent(token)}; path=/; max-age=604800; SameSite=Lax`;
      document.cookie = `razorpulse_auth_user=${encodeURIComponent(JSON.stringify(user))}; path=/; max-age=604800; SameSite=Lax`;
    }

    // One-click quick demo login
    function handleQuickDemoLogin() {
      const demoUser = {
        id: 'usr_demo_apex_01',
        name: 'Ajay Kumar',
        email: 'demo@razorpulse.ai',
        merchant_id: 'mch_apex_gear_001',
        company_name: 'Apex Electronics & Tech Gear',
        role: 'owner'
      };
      const token = 'rzp_token_usr_demo_apex_01_ZGVtb0ByYXpvcnB1bHNlLmFp';
      saveSession(token, demoUser);

      // Smooth transition to destination
      const btn = document.getElementById('btn-quick-demo');
      if (btn) {
        btn.innerHTML = '<span>✓</span><span>Authenticated! Redirecting...</span>';
        btn.classList.remove('bg-ink');
        btn.classList.add('bg-emerald-600');
      }

      setTimeout(() => {
        window.location.href = getRedirectUrl();
      }, 350);
    }

    // Standard email & password submission
    async function handleEmailLogin(e) {
      e.preventDefault();
      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      const errorBox = document.getElementById('auth-error-box');
      const errorMsg = document.getElementById('auth-error-msg');
      const submitBtn = document.getElementById('btn-submit');
      const submitText = document.getElementById('submit-text');
      const submitSpinner = document.getElementById('submit-spinner');

      errorBox.classList.add('hidden');
      submitBtn.disabled = true;
      submitText.innerText = 'Verifying credentials...';
      submitSpinner.classList.remove('hidden');

      try {
        let authSuccess = false;
        let token = '';
        let user = null;

        // Try backend API first
        try {
          const res = await fetch('http://localhost:3000/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            authSuccess = true;
            token = data.token;
            user = data.user;
          } else if (res.status === 401) {
            throw new Error(data.error || 'Invalid email or password');
          }
        } catch (apiErr) {
          // If backend connection refused, perform resilient client-side authentication
          if (apiErr.message.includes('Invalid')) {
            throw apiErr;
          }
          // Demo fallback check
          if (
            (email.toLowerCase() === 'demo@razorpulse.ai' || email.toLowerCase() === 'admin@apextech.in') &&
            (password === 'buildathon2026' || password === 'admin123')
          ) {
            authSuccess = true;
            token = 'rzp_token_usr_demo_apex_01_ZGVtb0ByYXpvcnB1bHNlLmFp';
            user = {
              id: 'usr_demo_apex_01',
              name: 'Ajay Kumar',
              email: email.toLowerCase(),
              merchant_id: 'mch_apex_gear_001',
              company_name: 'Apex Electronics & Tech Gear',
              role: 'owner'
            };
          } else {
            throw new Error('Invalid email or password. Use demo credentials or quick login.');
          }
        }

        if (authSuccess && user) {
          saveSession(token, user);
          submitText.innerText = 'Success! Opening dashboard...';
          submitSpinner.classList.add('hidden');
          setTimeout(() => {
            window.location.href = getRedirectUrl();
          }, 300);
        } else {
          throw new Error('Authentication failed');
        }
      } catch (err) {
        errorMsg.innerText = err.message || 'Login failed. Please verify credentials.';
        errorBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitText.innerText = 'Sign In to Dashboard';
        submitSpinner.classList.add('hidden');
      }
    }

    // If already logged in, redirect immediately
    window.addEventListener('DOMContentLoaded', () => {
      const token = localStorage.getItem('razorpulse_auth_token');
      const user = localStorage.getItem('razorpulse_auth_user');
      if (token && user) {
        const redirect = getRedirectUrl();
        if (redirect && redirect !== '/login') {
          window.location.href = redirect;
        }
      }
    });
  </script>
</Layout>
