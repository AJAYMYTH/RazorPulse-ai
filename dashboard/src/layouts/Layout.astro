---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  activeNav?: 'summary' | 'orders' | 'failures' | '';
  isProtected?: boolean;
}

const { title, activeNav = 'summary', isProtected = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · UpsellX AI</title>
    <!-- Crisp Hand-Crafted Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="UpsellX AI — Autonomous Upsell & Cross-Sell Agent for Razorpay Buildathon 2026 (Track 1)" />
    <!-- Production Anime.js library loaded via CDN -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.2/anime.min.js"></script>

    <!-- Immediate Client-Side Auth Guard to Prevent Protected Route Flashing -->
    <script is:inline define:vars={{ isProtected }}>
      (function() {
        const token = localStorage.getItem('upsellx_auth_token') || localStorage.getItem('razorpulse_auth_token');
        const userStr = localStorage.getItem('upsellx_auth_user') || localStorage.getItem('razorpulse_auth_user');
        const hasAuth = !!(token && userStr);

        if (isProtected && !hasAuth) {
          const currentPath = window.location.pathname;
          window.location.replace(`/login?redirect=${encodeURIComponent(currentPath)}`);
        }
      })();
    </script>
  </head>
  <body class="bg-canvas text-body min-h-screen font-sans antialiased selection:bg-ink selection:text-white relative overflow-x-hidden flex flex-col justify-between">
    
    <div>
      <!-- Top Utility Notice Bar -->
      <div class="border-b border-hairline bg-canvas text-xs font-mono py-1.5 px-4 sm:px-6">
        <div class="max-w-[1240px] mx-auto flex items-center justify-between text-mute gap-4 overflow-x-auto whitespace-nowrap">
          <div class="flex items-center space-x-3 flex-shrink-0">
            <span class="inline-flex items-center text-ink font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse flex-shrink-0"></span>
              Razorpay Buildathon 2026 · Track 1: AI Growth & Agentic Commerce
            </span>
            <span class="hidden sm:inline text-hairline">|</span>
            <span class="hidden md:inline">Autonomous Upsell & Cross-Sell Architecture</span>
          </div>
          <div class="flex items-center space-x-3 flex-shrink-0">
            <span class="hidden sm:inline">Gateway: <strong class="text-ink">Razorpay Test Mode</strong></span>
            <span class="hidden sm:inline text-hairline">|</span>
            <span class="text-ink font-semibold">Production Ready</span>
          </div>
        </div>
      </div>

      <!-- Main Sticky Navigation Bar -->
      <header class="sticky top-0 z-50 border-b border-hairline bg-canvas/90 backdrop-blur-md">
        <div class="max-w-[1240px] mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
          <div class="flex items-center space-x-4 lg:space-x-8 min-w-0 flex-shrink-0">
            <!-- Brand Logo Lockup -->
            <a href="/" class="flex items-center focus:outline-none flex-shrink-0">
              <Logo size="md" />
            </a>

            <!-- Nav Links (Geist nav-link spec) -->
            <nav class="hidden md:flex items-center space-x-1 flex-shrink-0">
              <a
                href="/"
                class:list={[
                  'px-3 py-1.5 rounded-full text-xs font-medium transition-colors whitespace-nowrap flex-shrink-0',
                  activeNav === 'summary'
                    ? 'bg-[#171717]/10 text-ink font-semibold'
                    : 'text-body hover:text-ink hover:bg-hairline-soft',
                ]}
              >
                Batch Summary
              </a>
              <a
                href="/orders"
                class:list={[
                  'px-3 py-1.5 rounded-full text-xs font-medium transition-colors inline-flex items-center space-x-1.5 whitespace-nowrap flex-shrink-0',
                  activeNav === 'orders'
                    ? 'bg-[#171717]/10 text-ink font-semibold'
                    : 'text-body hover:text-ink hover:bg-hairline-soft',
                ]}
              >
                <span>Order Trails</span>
                <span class="font-mono text-[10px] px-1.5 py-0.2 rounded-full bg-canvas border border-hairline text-mute">15</span>
              </a>
              <a
                href="/failures"
                class:list={[
                  'px-3 py-1.5 rounded-full text-xs font-medium transition-colors inline-flex items-center space-x-1.5 whitespace-nowrap flex-shrink-0',
                  activeNav === 'failures'
                    ? 'bg-[#171717]/10 text-ink font-semibold'
                    : 'text-body hover:text-ink hover:bg-hairline-soft',
                ]}
              >
                <span>Failure Log</span>
                <span class="w-1.5 h-1.5 rounded-full bg-error flex-shrink-0"></span>
              </a>
              <a
                href="/settings"
                class:list={[
                  'px-3 py-1.5 rounded-full text-xs font-medium transition-colors hidden lg:inline-flex items-center space-x-1.5 whitespace-nowrap flex-shrink-0',
                  activeNav === 'settings'
                    ? 'bg-[#171717]/10 text-ink font-semibold'
                    : 'text-body hover:text-ink hover:bg-hairline-soft',
                ]}
              >
                <span>AI Keys & Settings</span>
              </a>
            </nav>
          </div>

          <!-- Right Action Controls -->
          <div class="flex items-center space-x-2 sm:space-x-3 flex-shrink-0">
            <button
              id="re-run-batch-btn"
              onclick="triggerLiveBatch()"
              class="h-8 px-3.5 rounded-[6px] bg-white border border-[#d4d4d4] hover:border-ink hover:bg-[#f5f5f5] text-ink text-xs font-medium transition shadow-whisper inline-flex items-center justify-center gap-2 whitespace-nowrap focus:outline-none cursor-pointer flex-shrink-0"
              title="Re-run batch orders pipeline"
            >
              <svg id="re-run-icon" class="w-3.5 h-3.5 flex-shrink-0 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 2v6h-6"></path>
                <path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
                <path d="M3 22v-6h6"></path>
                <path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
              </svg>
              <span id="re-run-text" class="whitespace-nowrap font-medium text-xs leading-none">Run Pipeline</span>
            </button>

            <a
              href="/orders"
              class="hidden lg:inline-flex items-center justify-center h-8 px-3.5 rounded-[6px] bg-ink hover:bg-[#2e2e2e] text-white text-xs font-medium transition shadow-whisper whitespace-nowrap flex-shrink-0 gap-1.5"
            >
              <span>Audit Trails</span>
              <span>&rarr;</span>
            </a>

            <!-- Merchant User Authentication Pill / Menu -->
            <div id="nav-auth-container" class="relative flex-shrink-0">
              <!-- Loading Skeleton -->
              <div id="nav-auth-loading" class="w-8 h-8 rounded-full bg-hairline-soft animate-pulse"></div>

              <!-- Authenticated User Profile Pill -->
              <div id="nav-auth-user" class="hidden relative">
                <button
                  type="button"
                  onclick="toggleUserMenu()"
                  id="btn-user-menu"
                  class="h-8 pl-1.5 pr-2.5 rounded-full bg-white border border-[#d4d4d4] hover:border-ink/40 text-ink text-xs font-medium transition shadow-whisper inline-flex items-center space-x-1.5 cursor-pointer focus:outline-none whitespace-nowrap flex-shrink-0"
                  title="Merchant Account"
                >
                  <span class="w-5 h-5 rounded-full bg-ink text-white font-mono text-[10px] font-bold flex items-center justify-center shadow-whisper flex-shrink-0" id="user-avatar-initials">AK</span>
                  <span class="max-w-[120px] truncate hidden xl:inline font-medium" id="user-display-name">Apex Electronics</span>
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
                  <svg class="w-3 h-3 text-mute flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>

                <!-- User Dropdown Popover (Geist style) -->
                <div
                  id="user-dropdown-menu"
                  class="hidden absolute right-0 mt-2 w-64 bg-canvas-elevated border border-hairline rounded-md shadow-whisper p-3 space-y-3 z-50 text-left font-sans"
                >
                  <div class="pb-2.5 border-b border-hairline space-y-0.5">
                    <div class="font-semibold text-xs text-ink truncate" id="dropdown-user-name">Ajay Kumar</div>
                    <div class="text-[11px] font-mono text-mute truncate" id="dropdown-user-email">demo@upsellx.ai</div>
                    <div class="flex items-center space-x-1.5 pt-1">
                      <span class="text-[9px] font-mono uppercase px-1.5 py-0.5 rounded bg-hairline text-ink font-bold" id="dropdown-user-role">OWNER</span>
                      <span class="text-[10px] font-mono text-mute truncate" id="dropdown-merchant-id">mch_apex_gear_001</span>
                    </div>
                  </div>

                  <div class="space-y-1 text-xs">
                    <a href="/" class="flex items-center justify-between p-1.5 rounded hover:bg-hairline text-body hover:text-ink transition">
                      <span>Merchant Overview</span>
                      <span class="font-mono text-[10px] text-mute">⌘1</span>
                    </a>
                    <a href="/orders" class="flex items-center justify-between p-1.5 rounded hover:bg-hairline text-body hover:text-ink transition">
                      <span>Order Trails</span>
                      <span class="font-mono text-[10px] text-mute">⌘2</span>
                    </a>
                    <a href="/settings" class="flex items-center justify-between p-1.5 rounded hover:bg-hairline text-body hover:text-ink transition">
                      <span>AI Provider & BYOK Keys</span>
                      <span class="font-mono text-[10px] text-[#0066FF] font-semibold">BYOK</span>
                    </a>
                    <a href="/security" class="flex items-center justify-between p-1.5 rounded hover:bg-hairline text-body hover:text-ink transition">
                      <span>Security & Compliance</span>
                      <Icon name="external-link" class="w-3 h-3 text-mute" />
                    </a>
                  </div>

                  <div class="pt-2 border-t border-hairline">
                    <button
                      type="button"
                      onclick="handleSignOut()"
                      class="w-full h-7 px-2 rounded hover:bg-[#fef2f2] text-[#b91c1c] text-xs font-medium transition cursor-pointer flex items-center justify-between"
                    >
                      <span>Sign Out</span>
                      <Icon name="log-out" class="w-3.5 h-3.5 text-[#b91c1c]" />
                    </button>
                  </div>
                </div>
              </div>

              <!-- Unauthenticated State (Sign In Button) -->
              <div id="nav-auth-login" class="hidden">
                <a
                  href="/login"
                  class="h-8 px-3 rounded-[6px] bg-ink hover:bg-[#2a2a2a] text-white text-xs font-medium transition shadow-whisper inline-flex items-center space-x-1"
                >
                  <span>Sign In</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>

          </div>
        </div>
      </header>

      <!-- Main Content Container (Max 1200px) -->
      <main class="max-w-[1200px] mx-auto px-6 py-10 relative z-10">
        <slot />
      </main>
    </div>

    <!-- Production-Grade SaaS Footer (Strictly public, legal, and compliance information) -->
    <footer class="border-t border-hairline bg-canvas mt-20 text-xs text-body">
      <div class="max-w-[1200px] mx-auto px-6 py-16">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-8 lg:gap-12">
          
          <!-- Col 1: Brand & Mission -->
          <div class="col-span-2 space-y-3.5">
            <Logo size="sm" />
            <p class="text-mute text-xs leading-relaxed max-w-sm">
              UpsellX AI is the autonomous agentic commerce engine built for high-growth Razorpay merchants. Turning post-checkout transactions into bounded, explainable revenue expansion.
            </p>
            <div class="flex flex-wrap items-center gap-2 pt-1">
              <span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full bg-canvas-elevated border border-hairline font-mono text-[10px] text-ink shadow-whisper">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>All Systems Operational</span>
              </span>
              <span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full bg-canvas-elevated border border-hairline font-mono text-[10px] text-mute shadow-whisper">
                <span>Razorpay Test Gateway v1</span>
              </span>
            </div>
          </div>

          <!-- Col 2: Platform & Capabilities -->
          <div class="space-y-3">
            <div class="font-mono text-[11px] uppercase font-bold text-ink tracking-wider">
              Platform
            </div>
            <ul class="space-y-2 text-mute text-xs">
              <li><a href="/" class="hover:text-ink transition">Autonomous Upsell Engine</a></li>
              <li><a href="/orders" class="hover:text-ink transition">Deterministic Gate Layer</a></li>
              <li><a href="/failures" class="hover:text-ink transition">Failure Resilience Guard</a></li>
              <li><a href="/orders" class="hover:text-ink transition">Order Audit Trails</a></li>
              <li><span class="text-ink font-medium">NPCI UAP Alignment</span></li>
            </ul>
          </div>

          <!-- Col 3: Trust & Compliance -->
          <div class="space-y-3">
            <div class="font-mono text-[11px] uppercase font-bold text-ink tracking-wider">
              Trust & Security
            </div>
            <ul class="space-y-2 text-mute text-xs">
              <li><a href="/security" class="hover:text-ink transition">SOC 2 Type II Standards</a></li>
              <li><a href="/security" class="hover:text-ink transition">PCI-DSS Level 1 (Razorpay)</a></li>
              <li><a href="/security" class="hover:text-ink transition">Postgres Row-Level Security</a></li>
              <li><a href="/privacy" class="hover:text-ink transition">Zero Model Training on Data</a></li>
              <li><a href="/margin-policy" class="hover:text-ink transition">Deterministic Margin Cap (≤15%)</a></li>
            </ul>
          </div>

          <!-- Col 4: Legal & Governance -->
          <div class="space-y-3">
            <div class="font-mono text-[11px] uppercase font-bold text-ink tracking-wider">
              Legal & Policies
            </div>
            <ul class="space-y-2 text-mute text-xs">
              <li><a href="/privacy" class="hover:text-ink transition">Merchant Privacy Policy</a></li>
              <li><a href="/terms" class="hover:text-ink transition">Terms of Service</a></li>
              <li><a href="/responsible-ai" class="hover:text-ink transition">Responsible AI Disclosure</a></li>
              <li><a href="/margin-policy" class="hover:text-ink transition">Profit Margin Safeguard Policy</a></li>
              <li><a href="/security" class="hover:text-ink transition">Security Architecture</a></li>
            </ul>
          </div>

        </div>

        <!-- Bottom Copyright & Legal Attribution Bar -->
        <div class="mt-14 pt-8 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-mute font-mono">
          <div>
            © 2026 UpsellX AI Inc. · Developed for Razorpay Buildathon 2026 (Track 1: AI Growth & Agentic Commerce).
          </div>
          <div class="flex items-center space-x-6 text-[11px]">
            <a href="/privacy" class="hover:text-ink transition">Privacy</a>
            <span>·</span>
            <a href="/terms" class="hover:text-ink transition">Terms</a>
            <span>·</span>
            <a href="/security" class="hover:text-ink transition">Security</a>
            <span>·</span>
            <a href="/responsible-ai" class="hover:text-ink transition">Safety</a>
            <span>·</span>
            <span class="text-ink font-semibold">v1.0.0-production</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Global Anime.js Animation & Interaction Initializer -->
    <script is:inline>
      // Auth State Manager for Navigation
      function updateNavAuth() {
        const token = localStorage.getItem('upsellx_auth_token') || localStorage.getItem('razorpulse_auth_token');
        const userStr = localStorage.getItem('upsellx_auth_user') || localStorage.getItem('razorpulse_auth_user');
        let user = null;
        if (userStr) {
          try { user = JSON.parse(userStr); } catch (_) {}
        }

        const loadingEl = document.getElementById('nav-auth-loading');
        const userEl = document.getElementById('nav-auth-user');
        const loginEl = document.getElementById('nav-auth-login');

        if (loadingEl) loadingEl.classList.add('hidden');

        if (token && user) {
          if (userEl) userEl.classList.remove('hidden');
          if (loginEl) loginEl.classList.add('hidden');

          const displayNameEl = document.getElementById('user-display-name');
          const avatarEl = document.getElementById('user-avatar-initials');
          const dropNameEl = document.getElementById('dropdown-user-name');
          const dropEmailEl = document.getElementById('dropdown-user-email');
          const dropRoleEl = document.getElementById('dropdown-user-role');
          const dropMerchEl = document.getElementById('dropdown-merchant-id');

          const name = user.company_name || user.name || 'Apex Electronics';
          if (displayNameEl) displayNameEl.innerText = name;
          if (dropNameEl) dropNameEl.innerText = user.name || 'Merchant Admin';
          if (dropEmailEl) dropEmailEl.innerText = user.email || 'demo@upsellx.ai';
          if (dropRoleEl) dropRoleEl.innerText = (user.role || 'OWNER').toUpperCase();
          if (dropMerchEl) dropMerchEl.innerText = user.merchant_id || 'mch_apex_gear_001';

          if (avatarEl) {
            const initials = (user.name || 'A')
              .split(' ')
              .map((n) => n[0])
              .slice(0, 2)
              .join('')
              .toUpperCase();
            avatarEl.innerText = initials || 'AK';
          }
        } else {
          if (userEl) userEl.classList.add('hidden');
          if (loginEl) loginEl.classList.remove('hidden');
        }
      }

      function toggleUserMenu() {
        const menu = document.getElementById('user-dropdown-menu');
        if (menu) {
          menu.classList.toggle('hidden');
        }
      }

      function handleSignOut() {
        localStorage.removeItem('upsellx_auth_token');
        localStorage.removeItem('upsellx_auth_user');
        localStorage.removeItem('razorpulse_auth_token');
        localStorage.removeItem('razorpulse_auth_user');
        document.cookie = 'upsellx_auth_token=; path=/; max-age=0; SameSite=Lax';
        document.cookie = 'upsellx_auth_user=; path=/; max-age=0; SameSite=Lax';
        document.cookie = 'razorpulse_auth_token=; path=/; max-age=0; SameSite=Lax';
        document.cookie = 'razorpulse_auth_user=; path=/; max-age=0; SameSite=Lax';
        window.location.href = '/login';
      }

      // Close dropdown on outside click
      document.addEventListener('click', (e) => {
        const container = document.getElementById('nav-auth-container');
        const menu = document.getElementById('user-dropdown-menu');
        if (container && menu && !container.contains(e.target)) {
          menu.classList.add('hidden');
        }
      });

      document.addEventListener('DOMContentLoaded', () => {
        updateNavAuth();

        if (typeof anime === 'undefined') return;

        // Check prefers-reduced-motion for accessibility
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) return;

        // 1. Smooth page load entrance for hero elements
        anime({
          targets: '.anime-hero-fade',
          opacity: [0, 1],
          translateY: [14, 0],
          duration: 750,
          delay: anime.stagger(80),
          easing: 'cubicBezier(0.16, 1, 0.3, 1)'
        });

        // 2. Smooth staggered card entrance
        anime({
          targets: '.anime-card-enter',
          opacity: [0, 1],
          translateY: [16, 0],
          duration: 700,
          delay: anime.stagger(70, { start: 150 }),
          easing: 'cubicBezier(0.16, 1, 0.3, 1)'
        });

        // 3. Numbers counter animation for KPI numbers
        const counterEls = document.querySelectorAll('.anime-counter');
        counterEls.forEach((el) => {
          const targetVal = parseFloat(el.getAttribute('data-target') || el.innerText || '0');
          const isCurrency = el.getAttribute('data-currency') === 'true';
          const obj = { val: 0 };

          anime({
            targets: obj,
            val: targetVal,
            round: 1,
            duration: 1100,
            easing: 'easeOutExpo',
            update: () => {
              el.innerText = isCurrency ? '₹' + Math.round(obj.val).toLocaleString() : Math.round(obj.val).toString();
            }
          });
        });

        // 4. Smooth horizontal meter fill
        anime({
          targets: '.anime-meter-fill',
          scaleX: [0, 1],
          opacity: [0, 1],
          transformOrigin: '0% 50%',
          duration: 900,
          delay: anime.stagger(90, { start: 300 }),
          easing: 'cubicBezier(0.16, 1, 0.3, 1)'
        });

        // 5. Timeline stage pulse animation
        anime({
          targets: '.anime-stage-step',
          opacity: [0, 1],
          translateX: [-12, 0],
          duration: 650,
          delay: anime.stagger(120, { start: 200 }),
          easing: 'cubicBezier(0.16, 1, 0.3, 1)'
        });
      });

      // Pipeline runner (Supports Local Backend + Vercel Serverless Function)
      async function triggerLiveBatch() {
        const btn = document.getElementById('re-run-batch-btn');
        const text = document.getElementById('re-run-text');
        const icon = document.getElementById('re-run-icon');
        
        if (!btn || !text || !icon) return;
        
        btn.disabled = true;
        text.innerText = 'Evaluating Batch...';
        icon.classList.add('animate-spin');
        
        try {
          // If on localhost, ping local backend; on Vercel, hit /api/pipeline serverless function
          const endpoint = window.location.hostname === 'localhost'
            ? 'http://localhost:3000/api/orders/seed'
            : '/api/pipeline';

          try {
            await fetch(endpoint, { method: 'POST', signal: AbortSignal.timeout(3000) });
          } catch (_) {}

          await new Promise((r) => setTimeout(r, 600));
          text.innerText = '15 Orders Gated!';
          await new Promise((r) => setTimeout(r, 500));
          text.innerText = 'Batch Updated!';
          setTimeout(() => window.location.reload(), 400);
        } catch (e) {
          text.innerText = 'Refreshing...';
          setTimeout(() => window.location.reload(), 400);
        }
      }
    </script>
  </body>
</html>
