---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
}

const { size = 'md', showText = true } = Astro.props;

const dimensions = {
  sm: { box: 'w-7 h-7', px: 28, text: 'text-sm', sub: 'text-[9px]' },
  md: { box: 'w-8 h-8', px: 32, text: 'text-[15px]', sub: 'text-[10px]' },
  lg: { box: 'w-10 h-10', px: 40, text: 'text-lg', sub: 'text-xs' },
}[size];
---

<div class="inline-flex items-center space-x-2.5 select-none group">
  <!-- Professional UpsellX Precision Emblem -->
  <div class:list={[dimensions.box, 'flex-shrink-0 flex items-center justify-center']}>
    <svg viewBox="0 0 36 36" fill="none" class="w-full h-full">
      <!-- Dark Obsidian Base Shield Tile with 1px hairline border -->
      <rect width="36" height="36" rx="8" fill="#0C1527" stroke="#1E293B" stroke-width="1" />
      
      <!-- Dynamic Ascending Upsell 'X' Cross-Vectors -->
      <!-- Primary Deep Royal Blue Stem -->
      <path
        d="M10 26L26 10"
        stroke="#0066FF"
        stroke-width="4"
        stroke-linecap="round"
      />
      <!-- Intersecting Electric Cyan Upsell Vector -->
      <path
        d="M10 10L26 26"
        stroke="#38BDF8"
        stroke-width="4"
        stroke-linecap="round"
      />

      <!-- Precision Growth Apex Dot -->
      <circle cx="26" cy="10" r="2" fill="#FFFFFF" />
    </svg>
  </div>

  {showText && (
    <div class="flex flex-col">
      <div class="flex items-center space-x-1.5">
        <span class:list={[dimensions.text, 'font-semibold text-ink tracking-[-0.3px] leading-tight']}>
          Upsell<span class="text-[#0066FF]">X</span>
        </span>
        <span class="font-mono text-[9px] uppercase font-bold px-1.5 py-0.5 rounded-[4px] bg-[#0066FF]/10 text-[#0066FF] border border-[#0066FF]/20 leading-none">
          AI
        </span>
      </div>
      <span class:list={[dimensions.sub, 'font-mono uppercase font-medium text-mute tracking-wider leading-tight mt-0.5']}>
        Autonomous Commerce
      </span>
    </div>
  )}
</div>
