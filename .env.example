# ==============================================================================
# Environment Configuration — Upsell & Cross-Sell Agent
# Razorpay Buildathon 2026 · Track 1: AI Growth & Agentic Commerce
# ==============================================================================

# Server & Ports
PORT=3000
DASHBOARD_PORT=4321
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Database (Supabase / Postgres)
# If left empty, backend falls back to local SQLite/file-based storage with identical schema
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. Razorpay Credentials (Test Mode)
# Switch dashboard.razorpay.com to "Test Mode" -> Settings -> API Keys -> Generate
# If left empty, backend automatically falls back to Mock Execution Mode
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------------------
# 3. LLM Provider (BYOK - Bring Your Own Key)
# Use Google Gemini (free tier via Google AI Studio) or OpenAI
# If left empty, backend falls back to intelligent deterministic heuristic engine
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
